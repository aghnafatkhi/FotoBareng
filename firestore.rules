rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRoomHost(roomId) {
      return (isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        resource.data.hostId == request.auth.uid
      )) || (
        request.auth == null && (
          resource.data.hostId is string &&
          resource.data.hostId.size() > 0
        )
      );
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      // Room read: Allowed for single document lookup (join / presence checking)
      allow get: if true;
      allow list: if false;

      // Creation: Allowed for authenticated Firebase user or verified guest host ID
      allow create: if (
        isAuthenticated() && (
          request.resource.data.hostUid == request.auth.uid ||
          request.resource.data.hostId == request.auth.uid
        )
      ) || (
        request.auth == null &&
        request.resource.data.hostId is string &&
        request.resource.data.hostId.size() > 0 &&
        request.resource.data.hostId.size() <= 128
      );

      // Update: Authenticated or guest participants can update room state, slots, and session progress
      allow update: if true;

      // Deletion: Host can delete room
      allow delete: if isRoomHost(roomId);

      // Participants subcollection
      match /participants/{participantId} {
        allow read: if true;

        allow create, update: if (
          isAuthenticated() && (
            request.auth.uid == participantId ||
            isRoomHost(roomId)
          )
        ) || (
          request.auth == null &&
          participantId is string &&
          participantId.size() > 0 &&
          participantId.size() <= 128
        );

        allow delete: if (
          isAuthenticated() && (
            request.auth.uid == participantId ||
            isRoomHost(roomId)
          )
        ) || request.auth == null;
      }

      // Assets subcollection (custom frames, logos)
      match /assets/{assetId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isRoomHost(roomId);
      }

      // Sessions subcollection (photobooth rounds and captures)
      match /sessions/{sessionId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isRoomHost(roomId);
      }
    }
  }
}
